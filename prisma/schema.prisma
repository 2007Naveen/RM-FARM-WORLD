generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Cattle {
  id            Int             @id @default(autoincrement())
  name          String
  type          AnimalType      @default(COW)
  photoUrl      String?
  birthDate     DateTime
  source        AnimalSource    @default(BORN_HERE)
  motherId      Int?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  mother        Cattle?         @relation("CattleHierarchy", fields: [motherId], references: [id])
  calves        Cattle[]        @relation("CattleHierarchy")
  notes         CattleNote[]
  vaccinations  CattleVaccine[]
  inseminations Insemination[]
}

model Insemination {
  id                   Int      @id @default(autoincrement())
  cattleId             Int
  inseminationDate     DateTime
  expectedDeliveryDate DateTime
  createdAt            DateTime @default(now())
  cattle               Cattle   @relation(fields: [cattleId], references: [id], onDelete: Cascade)
}

model CattleVaccine {
  id          Int      @id @default(autoincrement())
  cattleId    Int
  name        String
  date        DateTime
  description String?
  createdAt   DateTime @default(now())
  cattle      Cattle   @relation(fields: [cattleId], references: [id], onDelete: Cascade)
}

model CattleNote {
  id        Int      @id @default(autoincrement())
  cattleId  Int
  date      DateTime
  text      String
  createdAt DateTime @default(now())
  cattle    Cattle   @relation(fields: [cattleId], references: [id], onDelete: Cascade)
}

model Hen {
  id           Int              @id @default(autoincrement())
  name         String
  type         HenType          @default(HEN)
  photoUrl     String?
  birthDate    DateTime
  source       AnimalSource     @default(BORN_HERE)
  motherId     Int?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  mother       Hen?             @relation("HenHierarchy", fields: [motherId], references: [id])
  chicks       Hen[]            @relation("HenHierarchy")
  incubations  Incubation[]
  notes        PoultryNote[]
  vaccinations PoultryVaccine[]
}

model Incubation {
  id                Int      @id @default(autoincrement())
  henId             Int
  startDate         DateTime
  expectedHatchDate DateTime
  eggCount          Int      @default(0)
  createdAt         DateTime @default(now())
  hen               Hen      @relation(fields: [henId], references: [id], onDelete: Cascade)
}

model PoultryVaccine {
  id          Int      @id @default(autoincrement())
  henId       Int
  name        String
  date        DateTime
  description String?
  createdAt   DateTime @default(now())
  hen         Hen      @relation(fields: [henId], references: [id], onDelete: Cascade)
}

model PoultryNote {
  id        Int      @id @default(autoincrement())
  henId     Int
  date      DateTime
  text      String
  createdAt DateTime @default(now())
  hen       Hen      @relation(fields: [henId], references: [id], onDelete: Cascade)
}

model Goat {
  id            Int           @id @default(autoincrement())
  name          String
  type          GoatType      @default(GOAT)
  photoUrl      String?
  birthDate     DateTime
  source        AnimalSource  @default(BORN_HERE)
  motherId      Int?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  mother        Goat?         @relation("GoatHierarchy", fields: [motherId], references: [id])
  kids          Goat[]        @relation("GoatHierarchy")
  matingRecords GoatMating[]
  notes         GoatNote[]
  vaccinations  GoatVaccine[]
}

model GoatMating {
  id                   Int      @id @default(autoincrement())
  goatId               Int
  matingDate           DateTime
  expectedDeliveryDate DateTime
  createdAt            DateTime @default(now())
  goat                 Goat     @relation(fields: [goatId], references: [id], onDelete: Cascade)
}

model GoatVaccine {
  id          Int      @id @default(autoincrement())
  goatId      Int
  name        String
  date        DateTime
  description String?
  createdAt   DateTime @default(now())
  goat        Goat     @relation(fields: [goatId], references: [id], onDelete: Cascade)
}

model GoatNote {
  id        Int      @id @default(autoincrement())
  goatId    Int
  date      DateTime
  text      String
  createdAt DateTime @default(now())
  goat      Goat     @relation(fields: [goatId], references: [id], onDelete: Cascade)
}

model DailyNote {
  id        Int      @id @default(autoincrement())
  date      DateTime @default(now())
  title     String
  content   String
  category  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum AnimalType {
  COW
  CALF
}

enum AnimalSource {
  BORN_HERE
  PURCHASED
}

enum HenType {
  HEN
  CHICK
}

enum GoatType {
  GOAT
  KID
}
